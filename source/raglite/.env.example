# Remote API example used in RAGLite's official documentation.
HERMESCLAW_RAG_LLM=gpt-4o-mini
HERMESCLAW_RAG_EMBEDDER=text-embedding-3-large
# OPENAI_API_KEY=replace_me

# Optional explicit DB URL. If omitted, wrapper uses source/.raglite/hermesclaw.duckdb.
# HERMESCLAW_RAG_DB_URL=duckdb:///absolute/path/to/source/.raglite/hermesclaw.duckdb

# Local examples (requires llama-cpp-python support; choose these instead of remote values):
# HERMESCLAW_RAG_LLM=llama-cpp-python/unsloth/Qwen3-4B-GGUF/*Q4_K_M.gguf@8192
# HERMESCLAW_RAG_EMBEDDER=llama-cpp-python/lm-kit/bge-m3-gguf/*F16.gguf@512
